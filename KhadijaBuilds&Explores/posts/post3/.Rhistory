library(tidyverse)
library(broom)
library(infer)
library(knitr)
data <- read.csv("electricity.csv")
cleaned <- data %>%
rename(Country = Entity) %>%
select(Country, Year, Solar)
analysis_data <- cleaned %>%
mutate(log_solar = log(Solar + 1))
ggplot(analysis_data, aes(x = Year, y = Solar)) +
geom_point(color = "#56C596", alpha = 0.8) +
labs(
title = "Solar Electricity Generation Across Countries Over Time",
x = "Year",
y = "Solar Electricity Generation (TWh)",
caption = "Source: Our World in Data"
)
ggplot(analysis_data, aes(x = Year, y = log_solar)) +
geom_point(color = "#56C596", alpha = 0.8) +
labs(
title = "Log-Transformed Solar Electricity Generation Across Countries",
x = "Year",
y = "Log(Solar Electricity Generation + 1)",
caption = "Source: Our World in Data"
)
correlation_value <- cor(analysis_data$Year, analysis_data$log_solar)
model <- lm(log_solar ~ Year, data = analysis_data)
model_tidy <- tidy(model) %>%
select(term, estimate)
kable(model_tidy, digits = 4, caption = "Regression Coefficients for the Model")
augmented_model <- augment(model)
ggplot(augmented_model, aes(x = .fitted, y = .resid)) +
geom_point(color = "#56C596", alpha = 0.8) +
geom_hline(yintercept = 0, linetype = "dashed") +
labs(
title = "Residual Plot for the Regression Model",
x = "Fitted Values (log(TWh + 1))",
y = "Residuals (log(TWh + 1))",
caption = "Source: Our World in Data"
)
r_squared <- summary(model)$r.squared
rmse <- sigma(model)
fit_table <- tibble(
Metric = c("R-squared", "RMSE on the log(TWh + 1) scale"),
Value = c(r_squared, rmse)
)
kable(fit_table, digits = 4, caption = "Model Fit Metrics")
set.seed(123)
boot_slopes <- analysis_data %>%
specify(log_solar ~ Year) %>%
generate(reps = 1000, type = "bootstrap") %>%
calculate(stat = "slope")
slope_ci <- get_ci(boot_slopes, level = 0.95)
slope_ci_clean <- slope_ci %>%
rename(
`Lower Bound` = lower_ci,
`Upper Bound` = upper_ci
)
kable(
slope_ci_clean,
digits = 4,
caption = "95% Bootstrap Confidence Interval for the Slope"
)
visualize(boot_slopes) +
shade_confidence_interval(endpoints = slope_ci) +
labs(
title = "Bootstrap Distribution of the Slope",
x = "Slope (log(TWh + 1) per year)",
y = "Count",
caption = "Source: Our World in Data"
)
prediction_year <- 2025
predicted_log <- predict(model, newdata = data.frame(Year = prediction_year))
predicted_solar <- exp(predicted_log) - 1
prediction_table <- tibble(
Year = prediction_year,
`Predicted Log Solar` = predicted_log,
`Predicted Solar (TWh)` = predicted_solar
)
kable(prediction_table, digits = 4, caption = "Point Prediction for Solar Electricity Generation in 2025")
set.seed(123)
boot_predictions <- analysis_data %>%
specify(log_solar ~ Year) %>%
generate(reps = 1000, type = "bootstrap") %>%
group_by(replicate) %>%
summarize(
pred_log = predict(
lm(log_solar ~ Year, data = pick(everything())),
newdata = data.frame(Year = prediction_year)
),
.groups = "drop"
) %>%
mutate(pred_solar = exp(pred_log) - 1)
prediction_ci <- tibble(
`Lower Bound (TWh)` = quantile(boot_predictions$pred_solar, 0.025),
`Upper Bound (TWh)` = quantile(boot_predictions$pred_solar, 0.975)
)
kable(
prediction_ci,
digits = 4,
caption = "95% Bootstrap Prediction Interval for Solar Electricity Generation in 2025"
)
ggplot(boot_predictions, aes(x = pred_solar)) +
geom_histogram(binwidth = 0.1, fill = "#56C596", color = "white") +
geom_vline(xintercept = prediction_ci$lower_ci, linetype = "dashed") +
geom_vline(xintercept = prediction_ci$upper_ci, linetype = "dashed") +
labs(
title = "Bootstrap Distribution of Predicted Solar Generation in 2025",
x = "Predicted Solar Electricity Generation (TWh)",
y = "Count",
caption = "Source: Our World in Data"
)
